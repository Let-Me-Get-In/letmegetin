#!/usr/bin/env bash
# Enforce the commit convention: '<type>(<scope>): <summary> (LET-<n>)'.
#
# - The ticket is read from the branch (LET-12-…) and appended to the
#   subject when the message does not carry it.
# - Phase-number scopes are rejected: the scope names the feature.
# - Merge, revert, fixup and squash commits are exempt.
set -euo pipefail

msg_file="$1"
branch="$(git symbolic-ref --short -q HEAD || true)"
first_line="$(head -n1 "$msg_file")"

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -qE '\([0-9]{2}(-[0-9]{2})?\)'; then
  echo "commit-msg: scope names the feature, not the phase (feat(api), not feat(01-02))." >&2
  exit 1
fi

ticket="$(printf '%s' "$branch" | grep -oE 'LET-[0-9]+' | head -n1 || true)"

if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|docs|test|chore|refactor|perf|style|ci)(\([a-z0-9-]+\))?!?: .+'; then
  echo "commit-msg: expected '<type>(<scope>): <summary> (LET-<n>)' — the ticket goes last." >&2
  exit 1
fi

if [ -n "$ticket" ] && ! printf '%s' "$first_line" | grep -qE "\($ticket\)$"; then
  { printf '%s (%s)\n' "$first_line" "$ticket"; tail -n +2 "$msg_file"; } >"$msg_file.tmp"
  mv "$msg_file.tmp" "$msg_file"
fi
