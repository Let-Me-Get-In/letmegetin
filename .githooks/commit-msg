#!/usr/bin/env bash
# Enforce LetMeGetIn commit conventions.
#
# - A Linear ticket is required: read from the branch (LMG-12-…), or the message
#   must already start with one (LMG-12 …).
# - The subject must be Conventional Commits *after* the ticket:
#     LMG-12 feat(api): add health endpoint
# - Phase-number scopes are rejected (e.g. feat(01-02)).
#
# Merge/revert/fixup commits are exempt.

set -euo pipefail

msg_file="$1"
branch="$(git rev-parse --abbrev-ref HEAD)"
ticket="$(printf '%s' "$branch" | grep -oE '^[A-Z]+-[0-9]+' || true)"
first_line="$(head -n1 "$msg_file")"

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

# Reject phase-number scopes: feat(01-02), fix(02), etc.
if printf '%s' "$first_line" | grep -qE '\([0-9]{2}(-[0-9]{2})?\)'; then
  echo "commit-msg: scope must name the feature, not the phase (e.g. feat(api), not feat(01-02))." >&2
  exit 1
fi

# Ensure the ticket prefix.
if [ -n "$ticket" ]; then
  if ! printf '%s' "$first_line" | grep -qE "^${ticket}[ :]"; then
    { printf '%s ' "$ticket"; cat "$msg_file"; } > "$msg_file.tmp"
    mv "$msg_file.tmp" "$msg_file"
    first_line="$(head -n1 "$msg_file")"
  fi
else
  if ! printf '%s' "$first_line" | grep -qE '^[A-Z]+-[0-9]+[ :]'; then
    echo "commit-msg: branch is not tied to a Linear ticket; name it 'LMG-12-slug' or start the message with 'LMG-12 '." >&2
    exit 1
  fi
fi

# Enforce Conventional Commits after the ticket.
if ! printf '%s' "$first_line" | grep -qE '^[A-Z]+-[0-9]+ (feat|fix|docs|test|chore|refactor|perf|style)(\([a-z0-9-]+\))?: .+'; then
  echo "commit-msg: expected 'LMG-12 feat(scope): description' (Conventional Commits after the ticket)." >&2
  exit 1
fi
