{
	email {$ACME_EMAIL}
	# Caddy prefers ZeroSSL as soon as an email is configured, and the requirement
	# is a Let's Encrypt certificate for all six names (EDGE-01). Pin the CA
	# rather than relying on the default order.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# One Caddy for every environment on the host.
#
# Each site block proxies to a qualified alias (`lmgi-<env>-api|web`) rather than
# the bare service name `api`/`web`: Compose publishes the bare name on every
# network a service joins, so two stacks sharing the edge network would both
# answer to `api` and each hostname could reach the other environment. The
# aliases are set in docker-compose.prod.yml from EDGE_API_ALIAS/EDGE_WEB_ALIAS,
# which the config repo renders from the values file's `project`.

# Public landing on the apex. The web container serves both hosts; `proxy.ts`
# rewrites `/` to the marketing page and sends every app route to `APP_DOMAIN`.
{$ROOT_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy lmgi-prod-web:3000
}

# One canonical host for search engines.
www.{$ROOT_DOMAIN} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy lmgi-prod-web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy lmgi-prod-api:8000
}

{$DEV_APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Belt and braces: the app also emits noindex, but a header covers every
		# response including the ones Next serves before metadata is resolved.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy lmgi-dev-web:3000
}

{$DEV_API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy lmgi-dev-api:8000
}
