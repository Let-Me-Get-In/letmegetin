# Copy to /etc/letmegetin/infisical.env (mode 600).
# Only the machine identity bootstrap lives here; application secrets stay in Infisical.
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
# EU Cloud: https://eu.infisical.com — self-hosted: your URL.
INFISICAL_DOMAIN=https://eu.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
