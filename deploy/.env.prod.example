# Copy to deploy/.env.prod (git-ignored) and fill every value.
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org
CADDY_CONFIG=Caddyfile

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# openssl rand -hex 32
LETMEGETIN_JWT_SECRET=change-me
LETMEGETIN_SENTRY_DSN=
GIT_SHA=dev
ALERT_WEBHOOK=

LETMEGETIN_SMTP_HOST=
LETMEGETIN_SMTP_PORT=587
LETMEGETIN_SMTP_USER=
LETMEGETIN_SMTP_PASSWORD=
LETMEGETIN_SMTP_FROM=no-reply@example.org

# Baked into the web build (must be present before `docker compose build web`).
NEXT_PUBLIC_SENTRY_DSN=

# Offsite backups — Cloudflare R2 (S3-compatible). Leave R2_BUCKET empty to stay local-only.
# Create an R2 API token with Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: EU jurisdiction or another S3 provider endpoint.
S3_ENDPOINT_URL=
S3_PREFIX=letmegetin
# Generic S3 alternative: set S3_BUCKET + AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY instead.
