# FALLBACK / REFERENCE ONLY. Production uses Infisical (deploy/infisical.env.example).
# Copy to deploy/.env.prod (git-ignored) and fill every value.
ROOT_DOMAIN=example.org
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org
CADDY_CONFIG=Caddyfile

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# openssl rand -hex 32
LETMEGETIN_JWT_SECRET=change-me
LETMEGETIN_SENTRY_DSN=
GIT_SHA=dev

LETMEGETIN_SMTP_HOST=
LETMEGETIN_SMTP_PORT=587
LETMEGETIN_SMTP_USER=
LETMEGETIN_SMTP_PASSWORD=
LETMEGETIN_SMTP_FROM=no-reply@example.org

# Baked into the web build (must be present before `docker compose build web`).
NEXT_PUBLIC_SENTRY_DSN=

# Offsite backups — Cloudflare R2, over its S3 API, signed by curl (no AWS CLI,
# no Wrangler). Create the pair on R2 → Manage R2 API Tokens, permission
# "Object Read & Write", scoped to the one bucket: an account-wide API token
# would also be able to rewrite the OpenTofu state bucket.
cf_account_id=
cf_backup_access_key_id=
cf_backup_secret_access_key=
cf_backup_bucket=
R2_PREFIX=letmegetin
# Optional: "eu" for an EU-jurisdiction bucket.
R2_JURISDICTION=
