[Unit]
Description=LetMeGetIn offsite restore drill (development stack)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/letmegetin
EnvironmentFile=/etc/letmegetin/infisical.env
ExecStart=/opt/letmegetin/scripts/with-secrets.sh /opt/letmegetin/scripts/restore-drill.sh
