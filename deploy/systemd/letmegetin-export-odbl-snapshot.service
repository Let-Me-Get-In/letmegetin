[Unit]
Description=LetMeGetIn ODbL export snapshot (weekly baseline)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/letmegetin
EnvironmentFile=/etc/letmegetin/infisical.env
ExecStart=/opt/letmegetin/scripts/with-secrets.sh /opt/letmegetin/scripts/export-odbl.sh snapshot
