[Unit]
Description=LetMeGetIn retention (idempotency keys, refresh tokens)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/letmegetin
EnvironmentFile=/opt/letmegetin/deploy/.env.prod
ExecStart=/usr/bin/docker compose -p letmegetin-prod --env-file /opt/letmegetin/deploy/.env.prod -f docker-compose.prod.yml exec -T api letmegetin-admin retention
